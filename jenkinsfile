pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '305601180466'
        ECR_REPO = 'app-repository'
        IMAGE_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
        EKS_CLUSTER = 'eks-cluster'
        NAMESPACE = 'jenkins-deploy'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION \
                | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                sh '''
                docker buildx build --platform linux/amd64 \
                  -t $IMAGE_REPO:$BUILD_NUMBER \
                  -t $IMAGE_REPO:latest \
                  ./app \
                  --push
                '''
            }
        }

        stage('Deploy to EKS with Helm') {
            steps {
                sh '''
                aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER

                helm upgrade --install hello-app ./helm-chart \
                  --namespace $NAMESPACE \
                  --create-namespace \
                  --set image.repository=$IMAGE_REPO \
                  --set image.tag=$BUILD_NUMBER
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                kubectl get pods -n $NAMESPACE
                kubectl get svc -n $NAMESPACE
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully. Application deployed to EKS.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }
    }
}